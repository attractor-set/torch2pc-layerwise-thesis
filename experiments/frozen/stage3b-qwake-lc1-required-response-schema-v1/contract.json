      "candidate_active": "candidate_l2>zero_atol",
      "cosine": "dot(reference,candidate)/(reference_l2*candidate_l2)_only_when_both_active",
      "difference_l2": "l2(candidate-reference)",
      "max_abs": "max(abs(candidate-reference))",
      "one_zero": "reference_active_xor_candidate_active",
      "reference_active": "reference_l2>zero_atol",
      "relative_l2": "difference_l2/scale",
      "scale": "max(reference_l2,candidate_l2,zero_atol)"
    },
    "normalized_entry_defect": "d=max(max_abs/max_abs_limit,relative_l2/max_relative_l2_limit,(1-cosine)/(1-min_cosine))_for_both_active;d=max(max_abs/max_abs_limit,relative_l2/max_relative_l2_limit)_for_both_zero;d=infinity_for_structural_nonfinite_or_one_zero_failure",
    "pass_threshold": "d_R<=1",
    "predicate_name": "registered_response_equivalence_v1",
    "reference_symmetry": "symmetric_scale_uses_max_reference_candidate_and_zero_atol",
    "response_defect": "d_R=max(entry_defect_over_all_registered_entries)",
    "response_pass_rule": "all_exact_structural_equalities_and_every_component_passes",
    "symbol": "a_i ~_R a_j",
    "transitivity_assumed": false,
    "zero_safe_rule": {
