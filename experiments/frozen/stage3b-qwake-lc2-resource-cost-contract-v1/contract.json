    "field_rules": {
      "compute_primary_time_ns": "union duration of core_compute intervals on lane profile primary_compute_clock",
      "control_wall_time_ns": "union duration of control_plane host_monotonic_ns intervals",
      "diagnostic_materialized_bytes": "sum unique diagnostic artifact sizes by sha256",
      "diagnostic_primary_time_ns": "union duration of diagnostic_mechanism intervals on lane profile diagnostic_clock",
      "fallback_invoked": "exact boolean copied from fallback record",
      "fallback_wall_time_ns": "union duration of fallback host_monotonic_ns intervals",
      "latency_wall_time_ns": "root_end_ns-root_start_ns; inclusive end-to-end component and never decomposed by summation",
      "observer_evidence_bytes": "sum unique observer evidence artifact sizes by sha256",
      "observer_overhead_time_ns": "max(0,instrumented_latency_ns-control_latency_ns) from complete matched calibration",
      "peak_allocated_bytes": "maximum registered allocated/live-memory source within root interval",
      "peak_reserved_bytes": "maximum registered reserved/committed-memory source within root interval"
    },
    "invalid_mapping_rule": "missing, nonfinite, negative, clock-incompatible, duplicate-owned, or profile-incompatible input yields incomplete cost vector and fail-closed selection",
    "mapping_id": "stage3b-qwake-measurement-to-cost-v1",
    "no_double_counting_rules": [
      "interval union replaces naive duration summation",
      "each interval has exactly one semantic owner",
      "latency is an inclusive independent component and is never added to decomposed times",
      "memory components are maxima and are never summed",
      "artifact bytes are counted once per owner and sha256",
      "observer overhead is not subtracted from latency or compute",
      "no scalar total cost is produced"
    ],
